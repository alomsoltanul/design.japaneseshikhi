# Content factory environment. Copy to .env.local and fill in.
# .env.local is gitignored — never commit real keys.

# Required for AI generation (Modules 1 & 3) and for Clip Finder's Bangla step
ANTHROPIC_API_KEY=

# Required for Clip Finder (step 0). Keys: https://nadeshiko.co/user/developer
# Scope READ_MEDIA. Server-side only — never expose this to the browser.
NADESHIKO_API_KEY=

# Optional — real audio + cross-machine content storage.
# Without these, content is cached in the OS temp dir and audio shows as MISSING.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=content
# SUPABASE_AUDIO_BUCKET=content

# Optional — base URL embedded in generated OBS scene snippets
# STUDIO_BASE_URL=http://localhost:5180

# ── Site access gate (middleware.ts) ────────────────────────────────────────
# Required in the Vercel project, or the whole deployment fails closed.
SESSION_SECRET=
# Optional: token an OBS browser source appends to /listening/studio?k=...
OBS_ACCESS_TOKEN=

# ── Supabase Auth for the access gate ───────────────────────────────────────
# Required in the Vercel project, or the whole deployment fails closed.
# SUPABASE_ANON_KEY is the publishable key — safe in the client by design.
# ALLOWED_EMAILS is the authorisation list: a valid Supabase token alone is not
# permission to enter, because the project also serves the public learning app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ALLOWED_EMAILS=
